{
  "name": "callmebackwhen",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm run --parallel dev:*",
    "dev:web": "pnpm --filter @callmebackwhen/web dev",
    "dev:api": "pnpm --filter @callmebackwhen/api dev",
    "build": "pnpm run -r build",
    "build:web": "pnpm --filter @callmebackwhen/web build",
    "build:api": "pnpm --filter @callmebackwhen/api build",
    "lint": "pnpm run -r lint",
    "typecheck": "pnpm run -r typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "test": "pnpm run -r test",
    "test:unit": "pnpm run -r test:unit",
    "db:migrate": "pnpm --filter @callmebackwhen/db migrate",
    "db:migrate:generate": "pnpm --filter @callmebackwhen/db migrate:generate",
    "db:migrate:revert": "pnpm --filter @callmebackwhen/db migrate:revert"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
