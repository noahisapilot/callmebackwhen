{
  "name": "callmebackwhen",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered personal secretary that makes phone calls for you",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @callmebackwhen/web dev",
    "dev:api": "pnpm --filter @callmebackwhen/api dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @callmebackwhen/web build",
    "build:api": "pnpm --filter @callmebackwhen/api build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @callmebackwhen/api db:migrate",
    "db:generate": "pnpm --filter @callmebackwhen/api db:generate",
    "db:studio": "pnpm --filter @callmebackwhen/api db:studio",
    "clean": "pnpm -r clean && rm -rf node_modules"
  },
  "keywords": [
    "ai",
    "voice",
    "phone",
    "secretary",
    "vapi"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
